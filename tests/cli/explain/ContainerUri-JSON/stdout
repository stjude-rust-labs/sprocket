{
  "source": "wdl-lint",
  "id": "ContainerUri",
  "tags": [
    "Clarity",
    "Portability"
  ],
  "description": "Ensures that values for the `container` key within `runtime`/`requirements` sections are well-formed.",
  "explanation": "This rule checks the following:\n\n- Containers should have a tag, as container URIs with no tags have no expectation that the behavior of the containers won't change between runs.\n- Use of the 'any' container URI (`*`) within an array of container URIs is ambiguous and should be avoided.\n- Empty container URI arrays are not disallowed by the specification but are ambiguous and should be avoided.",
  "examples": [
    {
      "negative": {
        "snippet": "version 1.2\n\ntask say_hello {\n    input {\n        String name\n    }\n\n    command <<<\n        echo \"Hello, ~{name}!\"\n    >>>\n\n    # No tag\n    requirements {\n        container: \"ubuntu\"\n    }\n}\n"
      },
      "revised": {
        "snippet": "version 1.2\n\ntask say_hello {\n    input {\n        String name\n    }\n\n    command <<<\n        echo \"Hello, ~{name}!\"\n    >>>\n\n    requirements {\n        container: \"ubuntu@sha256:cc925e589b7543b910fea57a240468940003fbfc0515245a495dd0ad8fe7cef1\"\n    }\n}\n"
      }
    }
  ],
  "url": null,
  "related": [
    "MutableContainerTag",
    "RedundantContainerArray"
  ],
  "config": [
    {
      "name": "severity",
      "description": "The severity of the rule's diagnostics: `off`, `note` or `warning`.",
      "default": "\"warning\""
    }
  ]
}
